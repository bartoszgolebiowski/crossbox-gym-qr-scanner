# ==============================================================================
# AWS IoT QR Scanner Simulator Configuration
# ==============================================================================

AWS_SECRET_NAME=secrets-manager-secret-name
AWS_REGION=eu-central-1

AWS_IOT_ENDPOINT=a1b2c3d4e5f6g7-ats.iot.eu-central-1.amazonaws.com
AWS_IOT_CLIENT_ID=iot_client_id
AWS_IOT_TOPIC=gym/scanners/iot_client_id/scan

AWS_CERT_DIR=certs
AWS_CERT_FILE=certificate.pem.crt
AWS_KEY_FILE=private.pem.key
AWS_ROOT_CA_FILE=AmazonRootCA1.pem

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
