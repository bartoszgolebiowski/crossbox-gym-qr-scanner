# ==============================================================================
# AWS IoT Edge QR Scanner Engine - Konfiguracja Środowiskowa (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Konfiguracja Skryptu CLI do Pobierania Certyfikatów (cli/fetch_certs_cli.py)
# ------------------------------------------------------------------------------
# Nazwa sekretu w AWS Secrets Manager zawierającego JSON z certyfikatami X.509
AWS_SECRET_NAME=hd360-qr-scanner/certs
AWS_REGION=eu-central-1

# ------------------------------------------------------------------------------
# 2. Ustawienia Portu Szeregowego USB (Skaner QR)
# ------------------------------------------------------------------------------
# Ścieżka do portu na hoście (Raspberry Pi) i wewnątrz kontenera Docker
HOST_SERIAL_PORT=/dev/ttyACM0
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUDRATE=9600
# ------------------------------------------------------------------------------
# 3. Ustawienia AWS IoT Core (Broker MQTT)
# ------------------------------------------------------------------------------
# Dedykowany punkt końcowy ATS dla konta AWS (z wdrożonego stosu CDK)
AWS_IOT_ENDPOINT=a3djsvufxw89jd-ats.iot.eu-central-1.amazonaws.com
AWS_IOT_CLIENT_ID=hd360-qr-scanner-01
AWS_IOT_TOPIC=gym/scanners/hd360-qr-scanner-01/scan
# ------------------------------------------------------------------------------
# 4. Ścieżki do Certyfikatów mTLS (Montowane przez Wolumen :ro)
# ------------------------------------------------------------------------------
# Katalog certyfikatów na hoście (gdzie cli/fetch_certs_cli.py zapisuje pliki)
HOST_CERTS_DIR=./certs

# Katalog i nazwy plików certyfikatów wewnątrz kontenera Docker
AWS_CERT_DIR=/app/certs
AWS_CERT_FILE=device.pem.crt
AWS_KEY_FILE=private.pem.key
AWS_ROOT_CA_FILE=AmazonRootCA1.pem

# ------------------------------------------------------------------------------
# 5. Logowanie & Tryby Deweloperskie / Mock
# ------------------------------------------------------------------------------
# Poziom logowania: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Włącz opcję 'true' jeśli chcesz przetestować aplikację bez podłączonego fizycznego skanera QR
MOCK_SERIAL=false
MOCK_SERIAL_INTERVAL=3.0

# Włącz opcję 'true' jeśli chcesz przetestować aplikację bez aktywnego brokera AWS IoT Core
MOCK_AWS=false
