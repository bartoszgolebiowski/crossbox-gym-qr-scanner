# ==============================================================================
# AWS IoT Edge QR Scanner Engine - Environment Template (.env.example)
# ==============================================================================

# AWS Secrets Manager Secret Name & Region
AWS_SECRET_NAME=crossbox-gym/iot/certs
AWS_REGION=eu-central-1

# Serial Port Settings
HOST_SERIAL_PORT=/dev/ttyACM0
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUDRATE=9600

# AWS IoT Core Settings
AWS_IOT_ENDPOINT=your-ats-endpoint.iot.eu-central-1.amazonaws.com
AWS_IOT_CLIENT_ID=crossbox-qr-scanner-01
AWS_IOT_TOPIC=gym/scanners/crossbox-qr-scanner-01/scan

# mTLS Certificate Directory and Files
HOST_CERTS_DIR=./certs
AWS_CERT_DIR=/app/certs
AWS_CERT_FILE=device.pem.crt
AWS_KEY_FILE=private.pem.key
AWS_ROOT_CA_FILE=AmazonRootCA1.pem

# System & Debugging
LOG_LEVEL=INFO
MOCK_SERIAL=false
MOCK_SERIAL_INTERVAL=2.0
